{
  "openapi": "3.1.0",
  "info": {
    "title": "Shashlychky API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/db": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Db",
        "operationId": "health_db_api_v1_health_db_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DbHealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Register",
        "description": "Create an account and log in right away.",
        "operationId": "register_api_v1_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Login",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Logout",
        "description": "Revoke the current session. Succeeds without a session too, so the UI can always call it.",
        "operationId": "logout_api_v1_auth_logout_post",
        "parameters": [
          {
            "name": "__session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "  Session"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "Read Me",
        "description": "The logged-in user; 401 without a valid session.",
        "operationId": "read_me_api_v1_me_get",
        "parameters": [
          {
            "name": "__session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "  Session"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "me"
        ],
        "summary": "Delete Me",
        "description": "Delete the account with its profile and sessions. Cannot be undone.",
        "operationId": "delete_me_api_v1_me_delete",
        "parameters": [
          {
            "name": "__session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "  Session"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/recipes": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "List My Recipes",
        "description": "The user's recipes, newest first.",
        "operationId": "list_my_recipes_api_v1_me_recipes_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 50,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          },
          {
            "name": "__session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "  Session"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RecipeRead"
                  },
                  "title": "Response List My Recipes Api V1 Me Recipes Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me/profile": {
      "get": {
        "tags": [
          "me"
        ],
        "summary": "Read Profile",
        "description": "Dietary profile and pantry; defaults for a user who never saved one.",
        "operationId": "read_profile_api_v1_me_profile_get",
        "parameters": [
          {
            "name": "__session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "  Session"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "me"
        ],
        "summary": "Update Profile",
        "description": "Replace the whole profile. Lists come back normalized (trimmed, de-duplicated).",
        "operationId": "update_profile_api_v1_me_profile_put",
        "parameters": [
          {
            "name": "__session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "  Session"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserProfile"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserProfile"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recipes": {
      "post": {
        "tags": [
          "recipes"
        ],
        "summary": "Create Recipe",
        "description": "Generate a recipe and store it; a logged-in user gets their profile and history applied.",
        "operationId": "create_recipe_api_v1_recipes_post",
        "parameters": [
          {
            "name": "__session",
            "in": "cookie",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "  Session"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipeRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recipes/{recipe_id}": {
      "get": {
        "tags": [
          "recipes"
        ],
        "summary": "Read Recipe",
        "operationId": "read_recipe_api_v1_recipes__recipe_id__get",
        "parameters": [
          {
            "name": "recipe_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Recipe Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipeRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recipes/{recipe_id}/nutrition": {
      "get": {
        "tags": [
          "recipes"
        ],
        "summary": "Read Recipe Nutrition",
        "description": "Calories and macros of a stored recipe from Silpo product data, optionally vs a goal.",
        "operationId": "read_recipe_nutrition_api_v1_recipes__recipe_id__nutrition_get",
        "parameters": [
          {
            "name": "recipe_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Recipe Id"
            }
          },
          {
            "name": "daily_kcal_goal",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 6000,
                  "minimum": 800
                },
                {
                  "type": "null"
                }
              ],
              "title": "Daily Kcal Goal"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipeNutrition"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DbHealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "database": {
            "type": "string",
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "DbHealthResponse"
      },
      "GoalComparison": {
        "properties": {
          "daily_kcal": {
            "type": "integer",
            "title": "Daily Kcal"
          },
          "per_serving_percent": {
            "type": "number",
            "title": "Per Serving Percent",
            "description": "Яку частку денної норми покриває одна порція"
          }
        },
        "type": "object",
        "required": [
          "daily_kcal",
          "per_serving_percent"
        ],
        "title": "GoalComparison"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse"
      },
      "IngredientNutrition": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "counted",
              "to_taste",
              "no_product",
              "no_data",
              "unknown_unit"
            ],
            "title": "Status"
          },
          "grams": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grams",
            "description": "Вага інгредієнта в рецепті, якщо її вдалося визначити"
          },
          "product_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Name",
            "description": "Товар Сільпо, з якого взято КБЖВ"
          },
          "per_100g": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NutritionFacts"
              },
              {
                "type": "null"
              }
            ]
          },
          "total": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NutritionFacts"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "name",
          "status",
          "grams",
          "product_name",
          "per_100g",
          "total"
        ],
        "title": "IngredientNutrition"
      },
      "IngredientRead": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity"
          },
          "unit": {
            "type": "string",
            "title": "Unit"
          },
          "have_at_home": {
            "type": "boolean",
            "title": "Have At Home",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "name",
          "unit"
        ],
        "title": "IngredientRead",
        "description": "An ingredient as stored. `unit` is free text here: rows written before the `Unit` enum\nexisted keep whatever the model said back then (\"зубчики\", \"пучок\") and must stay readable."
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "NutritionFacts": {
        "properties": {
          "kcal": {
            "type": "number",
            "title": "Kcal"
          },
          "protein_g": {
            "type": "number",
            "title": "Protein G"
          },
          "fat_g": {
            "type": "number",
            "title": "Fat G"
          },
          "carbs_g": {
            "type": "number",
            "title": "Carbs G"
          }
        },
        "type": "object",
        "required": [
          "kcal",
          "protein_g",
          "fat_g",
          "carbs_g"
        ],
        "title": "NutritionFacts"
      },
      "RecipeNutrition": {
        "properties": {
          "recipe_id": {
            "type": "integer",
            "title": "Recipe Id"
          },
          "servings": {
            "type": "integer",
            "title": "Servings"
          },
          "total": {
            "$ref": "#/components/schemas/NutritionFacts"
          },
          "per_serving": {
            "$ref": "#/components/schemas/NutritionFacts"
          },
          "counted_ingredients": {
            "type": "integer",
            "title": "Counted Ingredients"
          },
          "countable_ingredients": {
            "type": "integer",
            "title": "Countable Ingredients",
            "description": "Інгредієнти з кількістю (без 'за смаком')"
          },
          "ingredients": {
            "items": {
              "$ref": "#/components/schemas/IngredientNutrition"
            },
            "type": "array",
            "title": "Ingredients"
          },
          "goal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GoalComparison"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "recipe_id",
          "servings",
          "total",
          "per_serving",
          "counted_ingredients",
          "countable_ingredients",
          "ingredients",
          "goal"
        ],
        "title": "RecipeNutrition"
      },
      "RecipeRead": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "products": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Products"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "type": "string",
            "title": "Description"
          },
          "cooking_time_minutes": {
            "type": "integer",
            "title": "Cooking Time Minutes"
          },
          "servings": {
            "type": "integer",
            "title": "Servings"
          },
          "ingredients": {
            "items": {
              "$ref": "#/components/schemas/IngredientRead"
            },
            "type": "array",
            "title": "Ingredients"
          },
          "steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Steps"
          },
          "tips": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tips"
          },
          "clarifying_question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clarifying Question"
          }
        },
        "type": "object",
        "required": [
          "id",
          "products",
          "created_at",
          "title",
          "description",
          "cooking_time_minutes",
          "servings",
          "ingredients",
          "steps"
        ],
        "title": "RecipeRead",
        "description": "API response for a stored recipe. Deliberately lenient: the strict bounds in\n`RecipeContent` are the contract for *generation*; a recipe that was valid when it was\nsaved must never turn into a 500 because the contract got stricter later."
      },
      "RecipeRequest": {
        "properties": {
          "products": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "minItems": 1,
            "title": "Products"
          },
          "preferences": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Preferences"
          },
          "servings": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Servings",
            "default": 2
          }
        },
        "type": "object",
        "required": [
          "products"
        ],
        "title": "RecipeRequest"
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "RegisterRequest"
      },
      "UserProfile": {
        "properties": {
          "allergies": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Allergies",
            "default": []
          },
          "diets": {
            "items": {
              "type": "string",
              "enum": [
                "vegetarian",
                "vegan",
                "pescatarian",
                "gluten_free",
                "lactose_free",
                "halal",
                "fasting"
              ]
            },
            "type": "array",
