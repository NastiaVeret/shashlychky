{
  "openapi": "3.1.0",
  "info": {
    "title": "Shashlychky API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/db": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health Db",
        "operationId": "health_db_api_v1_health_db_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DbHealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recipes": {
      "post": {
        "tags": [
          "recipes"
        ],
        "summary": "Create Recipe",
        "description": "Generate a recipe from the user's products and store it.",
        "operationId": "create_recipe_api_v1_recipes_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecipeRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipeRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recipes/{recipe_id}": {
      "get": {
        "tags": [
          "recipes"
        ],
        "summary": "Read Recipe",
        "operationId": "read_recipe_api_v1_recipes__recipe_id__get",
        "parameters": [
          {
            "name": "recipe_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Recipe Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipeRead"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/recipes/{recipe_id}/nutrition": {
      "get": {
        "tags": [
          "recipes"
        ],
        "summary": "Read Recipe Nutrition",
        "description": "Calories and macros of a stored recipe from Silpo product data, optionally vs a goal.",
        "operationId": "read_recipe_nutrition_api_v1_recipes__recipe_id__nutrition_get",
        "parameters": [
          {
            "name": "recipe_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Recipe Id"
            }
          },
          {
            "name": "daily_kcal_goal",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 6000,
                  "minimum": 800
                },
                {
                  "type": "null"
                }
              ],
              "title": "Daily Kcal Goal"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecipeNutrition"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DbHealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "database": {
            "type": "string",
            "title": "Database"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database"
        ],
        "title": "DbHealthResponse"
      },
      "GoalComparison": {
        "properties": {
          "daily_kcal": {
            "type": "integer",
            "title": "Daily Kcal"
          },
          "per_serving_percent": {
            "type": "number",
            "title": "Per Serving Percent",
            "description": "Яку частку денної норми покриває одна порція"
          }
        },
        "type": "object",
        "required": [
          "daily_kcal",
          "per_serving_percent"
        ],
        "title": "GoalComparison"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "HealthResponse"
      },
      "Ingredient": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name",
            "description": "Назва інгредієнта українською"
          },
          "quantity": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Quantity",
            "description": "Кількість; null, якщо 'за смаком'"
          },
          "unit": {
            "type": "string",
            "title": "Unit",
            "description": "Одиниця: г, мл, шт, ст. л., ч. л. або 'за смаком'"
          },
          "have_at_home": {
            "type": "boolean",
            "title": "Have At Home",
            "description": "true, якщо інгредієнт є серед продуктів користувача або базовий (сіль, вода, олія)"
          }
        },
        "type": "object",
        "required": [
          "name",
          "unit",
          "have_at_home"
        ],
        "title": "Ingredient"
      },
      "IngredientNutrition": {
        "properties": {
          "name": {
            "type": "string",
            "title": "Name"
          },
          "status": {
            "type": "string",
            "enum": [
              "counted",
              "to_taste",
              "no_product",
              "no_data",
              "unknown_unit"
            ],
            "title": "Status"
          },
          "grams": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Grams",
            "description": "Вага інгредієнта в рецепті, якщо її вдалося визначити"
          },
          "product_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Product Name",
            "description": "Товар Сільпо, з якого взято КБЖВ"
          },
          "per_100g": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NutritionFacts"
              },
              {
                "type": "null"
              }
            ]
          },
          "total": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NutritionFacts"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "name",
          "status",
          "grams",
          "product_name",
          "per_100g",
          "total"
        ],
        "title": "IngredientNutrition"
      },
      "NutritionFacts": {
        "properties": {
          "kcal": {
            "type": "number",
            "title": "Kcal"
          },
          "protein_g": {
            "type": "number",
            "title": "Protein G"
          },
          "fat_g": {
            "type": "number",
            "title": "Fat G"
          },
          "carbs_g": {
            "type": "number",
            "title": "Carbs G"
          }
        },
        "type": "object",
        "required": [
          "kcal",
          "protein_g",
          "fat_g",
          "carbs_g"
        ],
        "title": "NutritionFacts"
      },
      "RecipeNutrition": {
        "properties": {
          "recipe_id": {
            "type": "integer",
            "title": "Recipe Id"
          },
          "servings": {
            "type": "integer",
            "title": "Servings"
          },
          "total": {
            "$ref": "#/components/schemas/NutritionFacts"
          },
          "per_serving": {
            "$ref": "#/components/schemas/NutritionFacts"
          },
          "counted_ingredients": {
            "type": "integer",
            "title": "Counted Ingredients"
          },
          "countable_ingredients": {
            "type": "integer",
            "title": "Countable Ingredients",
            "description": "Інгредієнти з кількістю (без 'за смаком')"
          },
          "ingredients": {
            "items": {
              "$ref": "#/components/schemas/IngredientNutrition"
            },
            "type": "array",
            "title": "Ingredients"
          },
          "goal": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/GoalComparison"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "recipe_id",
          "servings",
          "total",
          "per_serving",
          "counted_ingredients",
          "countable_ingredients",
          "ingredients",
          "goal"
        ],
        "title": "RecipeNutrition"
      },
      "RecipeRead": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "description": "Назва страви"
          },
          "description": {
            "type": "string",
            "title": "Description",
            "description": "1-2 речення про страву"
          },
          "cooking_time_minutes": {
            "type": "integer",
            "maximum": 600.0,
            "minimum": 1.0,
            "title": "Cooking Time Minutes"
          },
          "servings": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Servings"
          },
          "ingredients": {
            "items": {
              "$ref": "#/components/schemas/Ingredient"
            },
            "type": "array",
            "minItems": 1,
            "title": "Ingredients"
          },
          "steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "minItems": 1,
            "title": "Steps",
            "description": "Кроки приготування по порядку"
          },
          "tips": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tips",
            "description": "Коротка порада або варіант заміни"
          },
          "clarifying_question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Clarifying Question",
            "description": "Якщо з наданих продуктів неможливо зібрати страву або продукт незрозумілий, постав тут одне уточнювальне питання; інакше null"
          },
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "products": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Products"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "title",
          "description",
          "cooking_time_minutes",
          "servings",
          "ingredients",
          "steps",
          "id",
          "products",
          "created_at"
        ],
        "title": "RecipeRead"
      },
      "RecipeRequest": {
        "properties": {
          "products": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "minItems": 1,
            "title": "Products"
          },
          "preferences": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Preferences"
          },
          "servings": {
            "type": "integer",
            "maximum": 12.0,
            "minimum": 1.0,
            "title": "Servings",
            "default": 2
          }
        },
        "type": "object",
        "required": [
          "products"
        ],
        "title": "RecipeRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
