ENVIRONMENT=local
DEBUG=true
CORS_ORIGINS=http://localhost:5173

# Local Postgres (docker compose up db). For Cloud SQL via Auth Proxy see README.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=shashlychky
# DB_ECHO=true  # log SQL statements

# Gemini (https://aistudio.google.com/apikey). Never commit the real key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Auth sessions. Chrome and Firefox accept Secure cookies on http://localhost; Safari does not.
# SESSION_COOKIE_SECURE=false
# SESSION_TTL_DAYS=30
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15

# Silpo MCP (optional). Mock: run `make silpo-mock` and set http://127.0.0.1:8010/mcp
SILPO_MCP_URL=
